    "karma": "^6.4.3",
    "karma-babel-preprocessor": "^8.0.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-react",
        {
          "runtime": "classic"
        }
      ]
    ]
  }
